  "markup_patterns": [
    "<\\s*/?\\s*(span|font|div|p|br|strong|b|i|u)[^>]*>",
    "\\bspan\\s+style\\s*=\\s*size\\s*[：:]\\s*\\d+\\s*px",
    "\\bspan\\s+\\d+\\s*px",
    "\\bfont\\s+size\\s*=\\s*[\"']?\\d+[\"']?",
    "\\bstyle\\s*=\\s*[\"']?[^\"'\\s>]+[\"']?",
    "\\btarget\\s*=\\s*[\"']?[A-Za-z0-9_-]+[\"']?",
    "(?:t\\.rkc[”\"']*\\s*(?:tart[”\"']*blank[”\"']*(?:&gt;|>)?)?)+",
    "(?:&quot;|[”\"'])\\s*tart(?:&quot;|[”\"'])\\s*blank(?:&quot;|[”\"'])?(?:&gt;|>)?"
  ],
  "noise_line_patterns": [
    "^[\\s　]*[┏┓┗┛┃━╔╗╚╝║═╭╮╰╯│─◢◣\\+\\-=]{4,}[\\s　]*$",
    "^[\\s　]*[·。\\.]{6,}[\\s　]*$",
    "^[\\s　]*[-_=*#]{5,}[\\s　]*$"
  ],
  "chapter_patterns": [
    "^[\\s　]*(第[零〇一二三四五六七八九十百千万0-9]+[章节回卷部集篇])([、.．:：\\s　-]*)(.*)$",
    "^[\\s　]*([0-9]{1,4})[、.．:：\\s　-]+(.{0,40})$"
  ],
  "filename_strip_patterns": [
    "\\.楼中网\\(LOUZHONG8\\.COM\\)",
    "_楼中网\\(LOUZHONG8\\.COM\\)",
    "-楼中网",
    "_楼中网",
    "楼中网",
    "搜书吧"
  ]
}
