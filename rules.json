{
  "version": 1,
  "description": "TXT cleanup rules for novel-style plain text files.",
  "profiles": {
    "safe": {
      "remove_ads": true,
      "normalize_punctuation": false,
      "indent_paragraphs": false,
      "normalize_chapters": false,
      "join_broken_lines": false,
      "remove_duplicate_lines": false
    },
    "normal": {
      "remove_ads": true,
      "normalize_punctuation": true,
      "indent_paragraphs": true,
      "normalize_chapters": false,
      "join_broken_lines": false,
      "remove_duplicate_lines": false
    },
    "format": {
      "remove_ads": true,
      "normalize_punctuation": true,
      "indent_paragraphs": true,
      "normalize_chapters": false,
      "join_broken_lines": false,
      "remove_duplicate_lines": true
    },
    "join": {
      "remove_ads": true,
      "normalize_punctuation": true,
      "indent_paragraphs": true,
      "normalize_chapters": false,
      "join_broken_lines": true,
      "remove_duplicate_lines": true
    },
    "aggressive": {
      "remove_ads": true,
      "normalize_punctuation": true,
      "indent_paragraphs": true,
      "normalize_chapters": true,
      "join_broken_lines": true,
      "remove_duplicate_lines": true
    }
