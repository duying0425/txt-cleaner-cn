    "www\\.[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
    "https?://\\S+",
    "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
    "最新地址",
    "请收藏",
    "请牢记",
    "永久地址",
    "备用网址",
